{"name": "08-api-crashes-lease5s", "description": "Two API instances; every 4 s one is SIGKILLed (rotating) and restarted 1 s later. 40 ms median processor latency keeps requests in flight at kill time. Clients rotate instances on retry.", "seed": 20240601, "dataset": "data/ulb-creditcard.csv", "offset": 0, "rows": 20000, "merchants": 200, "merchant_zipf_s": 1.1, "fraud_payment_method": "pm_card_radarBlock", "refund_fraction": 0.02, "load": {"mode": "closed", "concurrency": 32}, "client": {"timeout_ms": 5000, "max_attempts": 12, "backoff_base_ms": 50, "backoff_max_ms": 2000}, "server": {"instances": 2, "idempotency_mode": "on", "env": {"LEASE": "5s"}}, "processor": {"kind": "sim", "faults": {"latency_median_ms": 40, "latency_sigma": 0.3}}, "drain_timeout_s": 120, "events": [{"at_s": 3, "every_s": 4, "type": "api_crash", "duration_s": 1, "instance": -1}]}