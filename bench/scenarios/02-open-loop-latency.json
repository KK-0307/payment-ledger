{
  "name": "02-open-loop-latency",
  "description": "Open-loop replay of the dataset's own arrival pattern, time-scaled to a mean of 250 tx/s, with log-normal processor latency (median 150 ms, sigma 0.6). Latency is measured from scheduled arrival (no coordinated omission).",
  "seed": 20240601,
  "dataset": "data/ulb-creditcard.csv",
  "offset": 0,
  "rows": 20000,
  "merchants": 200,
  "merchant_zipf_s": 1.1,
  "fraud_payment_method": "pm_card_radarBlock",
  "refund_fraction": 0.02,
  "load": {
    "mode": "open",
    "concurrency": 512,
    "target_rate": 250
  },
  "client": {
    "timeout_ms": 5000,
    "max_attempts": 12,
    "backoff_base_ms": 50,
    "backoff_max_ms": 2000
  },
  "server": {
    "instances": 1,
    "idempotency_mode": "on"
  },
  "processor": {
    "kind": "sim",
    "faults": {
      "latency_median_ms": 150,
      "latency_sigma": 0.6
    }
  },
  "drain_timeout_s": 120
}
